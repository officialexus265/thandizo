generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSettings {
  id           String   @id @default("default")
  siteName     String   @default("thandizo")
  logoUrl      String?
  contactEmail String   @default("officialnexus265@gmail.com")
  primaryColor String   @default("#1f2937")
  accentColor  String   @default("#b91c1c")
  successColor String   @default("#15803d")
  refundFeePercent Float  @default(10)
  adminPhone   String?
  callWindow   String?  // e.g. "Mon–Fri 9:00–12:00 CAT"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  developerName String?
  developerId  String?
  developer    Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  workProgress Int      @default(0)
  progressNote String?
  shortDesc    String
  fullDesc     String        @db.Text
  targetAmount Decimal       @db.Decimal(12, 2)
  currency     String        @default("MWK")
  raisedAmount Decimal       @default(0) @db.Decimal(12, 2)
  donorCount   Int           @default(0)
  status       ProjectStatus @default(ACTIVE)
  isPinned     Boolean       @default(false)
  pinOrder     Int           @default(0)
  thumbnailUrl String?
  // Refund / legitimacy
  flagReason   String?       @db.Text
  flaggedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  media            Media[]
  donations        Donation[]
  partnerInterests PartnerInterest[]
  refundBatches    RefundBatch[]
  targetChangeRequests TargetChangeRequest[]
}

enum ProjectStatus {
  ACTIVE
  FUNDED
  CLOSED
  FLAGGED
}

model Media {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  type      MediaType @default(IMAGE)
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model Donation {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount           Decimal           @db.Decimal(12, 2)
  currency         String
  donorName        String?
  isAnonymous      Boolean           @default(false)
  email            String?
  phone            String?
  preferredContact ContactPreference @default(NONE)
  message          String?
  txRef            String            @unique
  paychanguRef     String?
  status           DonationStatus    @default(PENDING)
  // HOLD = eligible for refund until project closes; DIRECT = released, not refundable
  fundMode         FundMode          @default(HOLD)
  refundItemId     String?
  refundItem       RefundItem?       @relation(fields: [refundItemId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum FundMode {
  HOLD
  DIRECT
}

enum ContactPreference {
  NONE
  EMAIL
  SMS
  BOTH
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model NotificationLog {
  id         String   @id @default(cuid())
  donationId String?
  type       String
  recipient  String
  message    String   @db.Text
  status     String
  createdAt  DateTime @default(now())
}

model PartnerInterest {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  email       String?
  phone       String?
  message     String?  @db.Text
  status      String   @default("NEW")
  isPublic    Boolean  @default(false)
  displayName String?
  logoUrl     String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One refund run for a flagged project
model RefundBatch {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason          String       @db.Text
  status          RefundStatus @default(PENDING)
  totalDonated    Decimal      @default(0) @db.Decimal(12, 2)
  totalFees       Decimal      @default(0) @db.Decimal(12, 2)
  totalRefunded   Decimal      @default(0) @db.Decimal(12, 2)
  donorCount      Int          @default(0)
  successCount    Int          @default(0)
  failCount       Int          @default(0)
  manualCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  items RefundItem[]
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

// One payout line per donor (aggregated)
model RefundItem {
  id              String           @id @default(cuid())
  batchId         String
  batch           RefundBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  donorName       String?
  email           String?
  phone           String?
  preferredContact ContactPreference @default(NONE)
  currency        String           @default("MWK")
  grossAmount     Decimal          @db.Decimal(12, 2) // sum of donations
  feeAmount       Decimal          @db.Decimal(12, 2) // 10%
  netAmount       Decimal          @db.Decimal(12, 2) // 90% to refund
  status          RefundItemStatus @default(PENDING)
  payoutRef       String?          // PayChangu charge/tx id
  payoutError     String?
  operatorRefId   String?          // Airtel / TNM operator id
  notifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  donations Donation[]
}

enum RefundItemStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  MANUAL // no phone / non-MWK — needs manual handling
}

// Generic analytics events — visits now; ads/other later
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // page_view | ad_view | ad_click | custom
  path      String?
  label     String?  // e.g. ad slot id, campaign name
  referrer  String?
  sessionId String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
}


model ProjectSubmission {
  id              String   @id @default(cuid())
  title           String
  developerName   String
  developerEmail  String
  developerPhone  String?
  shortDesc       String
  fullDesc        String   @db.Text
  targetAmount    Decimal  @db.Decimal(12, 2)
  currency        String   @default("MWK")
  status          SubmissionStatus @default(PENDING)
  adminNotes      String?  @db.Text
  scheduledNote   String?  // optional note included in approval email (e.g. preferred call slot)
  reviewedAt      DateTime?
  approvedProjectId String? // set when a live Project is created on approve
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}


model Developer {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  accessCodeHash String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects            Project[]
  targetChangeRequests TargetChangeRequest[]
}

model TargetChangeRequest {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  developerId   String
  developer     Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  currentTarget Decimal  @db.Decimal(12, 2)
  requestedTarget Decimal @db.Decimal(12, 2)
  reason        String?  @db.Text
  status        String   @default("PENDING") // PENDING APPROVED REJECTED
  adminNote     String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
}
