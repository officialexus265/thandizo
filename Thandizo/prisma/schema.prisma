generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default("default")
  siteName    String   @default("thandizo")
  logoUrl     String?
  contactEmail String  @default("officialnexus265@gmail.com")
  primaryColor String  @default("#1f2937")
  accentColor  String  @default("#b91c1c")
  successColor String  @default("#15803d")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  shortDesc     String
  fullDesc      String   @db.Text
  targetAmount  Decimal  @db.Decimal(12, 2)
  currency      String   @default("MWK")
  raisedAmount  Decimal  @default(0) @db.Decimal(12, 2)
  donorCount    Int      @default(0)
  status        ProjectStatus @default(ACTIVE)
  isPinned      Boolean  @default(false)
  pinOrder      Int      @default(0)
  thumbnailUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  media         Media[]
  donations     Donation[]
  partnerInterests PartnerInterest[]
}

enum ProjectStatus {
  ACTIVE
  FUNDED
  CLOSED
}

model Media {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  publicId    String?
  type        MediaType @default(IMAGE)
  caption     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model Donation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  currency        String
  donorName       String?
  isAnonymous     Boolean  @default(false)
  email           String?
  phone           String?
  preferredContact ContactPreference @default(NONE)
  message         String?
  txRef           String   @unique
  paychanguRef    String?
  status          DonationStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ContactPreference {
  NONE
  EMAIL
  SMS
  BOTH
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model NotificationLog {
  id          String   @id @default(cuid())
  donationId  String?
  type        String
  recipient   String
  message     String   @db.Text
  status      String
  createdAt   DateTime @default(now())
}

model PartnerInterest {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  email       String?
  phone       String?
  message     String?  @db.Text
  status      String   @default("NEW") // NEW, CONTACTED, CLOSED
  isPublic    Boolean  @default(false) // promoted to a public "Sponsored by" listing
  displayName String?  // public-facing name, may differ from submitted name
  logoUrl     String?  // public-facing logo/photo
  websiteUrl  String?  // optional link when publicly displayed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
